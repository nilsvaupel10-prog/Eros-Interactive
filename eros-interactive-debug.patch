diff --git a/scripts/scan-secrets.mjs b/scripts/scan-secrets.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/scan-secrets.mjs
@@
+import { readFileSync, readdirSync, statSync } from 'node:fs';
+import { join } from 'node:path';
+
+const root = process.cwd();
+const ignored = new Set(['.git', 'node_modules', 'dist', 'build', 'coverage']);
+const findings = [];
+
+const patterns = [
+  { name: 'Google API key', regex: /AIza[0-9A-Za-z_-]{20,}/g },
+  { name: 'OpenRouter key', regex: /sk-or-v1-[0-9A-Za-z_-]+/g },
+  { name: 'Generic bearer token', regex: /Bearer\s+[0-9A-Za-z._-]{20,}/g },
+  { name: 'Private key block', regex: /-----BEGIN [A-Z ]*PRIVATE KEY-----/g },
+];
+
+function walk(dir) {
+  for (const entry of readdirSync(dir)) {
+    if (ignored.has(entry)) continue;
+    const fullPath = join(dir, entry);
+    const stat = statSync(fullPath);
+    if (stat.isDirectory()) {
+      walk(fullPath);
+      continue;
+    }
+    if (!/\.(ts|tsx|js|jsx|json|mjs|cjs|env|md|html|css)$/.test(entry)) continue;
+    const text = readFileSync(fullPath, 'utf8');
+    for (const pattern of patterns) {
+      const matches = text.match(pattern.regex);
+      if (matches) {
+        findings.push({ file: fullPath.replace(root + '/', ''), type: pattern.name, count: matches.length });
+      }
+    }
+  }
+}
+
+walk(root);
+
+if (findings.length > 0) {
+  console.error('Potential secrets detected:');
+  for (const finding of findings) {
+    console.error(`- ${finding.file}: ${finding.type} (${finding.count})`);
+  }
+  process.exit(1);
+}
+
+console.log('No obvious secrets found.');
